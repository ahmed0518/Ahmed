# Explicit, non-secret values for the e2e run (SPEC §9). Never used in production.
# The Playwright config adds SHOPIFY_API_URL (the mock) and SHOPIFY_ADMIN_TOKEN=test_e2e.
SHOPIFY_STORE_DOMAIN=mock-store.myshopify.com
SHOPIFY_ADMIN_HANDLE=mock-store
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PIN_PEPPER=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
ADMIN_PASSCODE=e2e-admin-passcode-not-secret
API_TOKENS=claude:e2e_claude_token_0123456789abcdef0123456789,maks-ai:e2e_maks_token_0123456789abcdef0123456789abc
READ_TOKEN=
TRUST_PROXY=
DISPLAY_TZ=America/New_York
