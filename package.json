{
  "name": "trax-production-status",
  "version": "1.0.0",
  "private": true,
  "description": "Production status per product on TraxNYC Shopify orders, with who/when on every change and a read API for AI agents.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/standalone-static.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "mock:shopify": "tsx tests/mock-shopify/server.ts",
    "setup:shopify": "tsx scripts/setup-shopify.ts",
    "agents:md": "tsx scripts/write-agents-md.ts",
    "audit:prod": "node scripts/audit.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
