      var line = { fill: 'none', stroke: '#000', 'stroke-opacity': .16, 'stroke-width': 2.2, 'stroke-linecap': 'round' };
      bodyG.appendChild(el('path', Object.assign({ d: 'M190 182 Q' + (200 - W * 0.45) + ' 172 ' + (L + 26) + ' 184' }, line)));
      bodyG.appendChild(el('path', Object.assign({ d: 'M210 182 Q' + (200 + W * 0.45) + ' 172 ' + (R - 26) + ' 184' }, line)));
      bodyG.appendChild(el('path', Object.assign({ d: 'M200 196 L200 ' + (muscle ? 330 : 300) }, line, { 'stroke-opacity': .08 })));
      var pec = muscle ? 296 : 286, pw = W * (muscle ? 0.72 : 0.6);
      bodyG.appendChild(el('path', Object.assign({ d: 'M' + (200 - pw) + ' ' + (pec - 28) + ' Q' + (200 - pw * 0.55) + ' ' + (pec + 8) + ' 196 ' + (pec - 6) }, line, { 'stroke-opacity': muscle ? .14 : .08 })));
      bodyG.appendChild(el('path', Object.assign({ d: 'M' + (200 + pw) + ' ' + (pec - 28) + ' Q' + (200 + pw * 0.55) + ' ' + (pec + 8) + ' 204 ' + (pec - 6) }, line, { 'stroke-opacity': muscle ? .14 : .08 })));
