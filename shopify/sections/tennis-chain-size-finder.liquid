    // given "slack" = chain length minus what the neck, build and width use up.
    var SLACK_TO_Y = [[-2, 146], [1, 152], [2, 160], [4, 190], [6, 226], [9, 284], [12, 346], [16, 420]];
    var ZONES = [['tight', 172], ['collarbone', 206], ['upper', 252], ['mid', 314], ['low', 999]];
    var ZONE_LABEL = { tight: 'Tight', collarbone: 'Collarbone', upper: 'Upper chest', mid: 'Mid chest', low: 'Low' };
    var ZONE_Y = { tight: 158, collarbone: 190, upper: 226, mid: 284, low: 346 };

    var state = { step: 1, override: null, drop: 60, layer: false };

    function val(name) {
      var el = root.querySelector('[name="' + name + '"]:checked') || root.querySelector('[name="' + name + '"]');
