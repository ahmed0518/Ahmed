      for (var i = 1; i < pts.length; i++) {
        var dx = pts[i][0] - pts[i - 1][0], dy = pts[i][1] - pts[i - 1][1];
        acc += Math.hypot(dx, dy);
        if (acc >= gap) { out.push([pts[i][0], pts[i][1], Math.atan2(dy, dx) * 180 / Math.PI]); acc = 0; }
      }
      return out;
    }

    function sparkle(x, y, r, delay) {
      return el('path', { class: 'tcsf-tw', fill: '#fff', style: 'animation-delay:' + delay + 's',
        d: 'M' + x + ' ' + (y - r) + ' L' + (x + r * .2) + ' ' + (y - r * .2) + ' L' + (x + r) + ' ' + y + ' L' + (x + r * .2) + ' ' + (y + r * .2) +
           ' L' + x + ' ' + (y + r) + ' L' + (x - r * .2) + ' ' + (y + r * .2) + ' L' + (x - r) + ' ' + y + ' L' + (x - r * .2) + ' ' + (y - r * .2) + ' Z' });
    }

    // One tennis link: a square metal box setting holding a round brilliant diamond.
    function stoneSvg(d) {
