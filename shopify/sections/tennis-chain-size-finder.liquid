    function el(tag, attrs) {
      var n = document.createElementNS(NS, tag);
      for (var k in attrs) n.setAttribute(k, attrs[k]);
      return n;
    }

    function drawBody(build) {
      var W = 118 * SHOULDERS[build], L = 200 - W, R = 200 + W;
      var muscle = build === 'athletic' || build === 'large';
      var skin = 'url(#' + ID + '-skin)';
      bodyG.innerHTML = '';
      bodyG.appendChild(el('path', { fill: skin, d:
        'M176 110 L176 142 C176 158 ' + (L + 44) + ' 164 ' + (L + 14) + ' 176 ' +
        'C' + (L - 6) + ' 184 ' + (L - 14) + ' 212 ' + (L - 16) + ' 252 L' + (L - 8) + ' 470 L' + (R + 8) + ' 470 ' +
        'L' + (R + 16) + ' 252 C' + (R + 14) + ' 212 ' + (R + 6) + ' 184 ' + (R - 14) + ' 176 ' +
        'C' + (R - 44) + ' 164 224 158 224 142 L224 110 Z' }));
      bodyG.appendChild(el('ellipse', { cx: 200, cy: 70, rx: 40, ry: 50, fill: skin }));
