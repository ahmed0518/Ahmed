{% comment %}
  Diamond Tennis Chain Size Finder
  A step-by-step quiz that recommends a tennis chain length (and width) from
  neck size, desired fit, build and chain width, then lets the customer "try on"
  the result on a live model: drag the length, switch width, metal and skin
  tone, and preview a layered stack. Self-contained: no apps or external
  scripts. Add it to any page via Online Store > Customize.
{% endcomment %}

<div class="tcsf" id="tcsf-{{ section.id }}">
  <div class="tcsf__inner">
    <header class="tcsf__header">
      <p class="tcsf__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="tcsf__title">{{ section.settings.heading }}</h2>
      <p class="tcsf__intro">{{ section.settings.intro }}</p>
      <svg class="tcsf__strand" viewBox="0 0 600 24" aria-hidden="true" data-strand></svg>
    </header>

    <div class="tcsf__app" data-view="quiz">
      <div class="tcsf__stage">
        <div class="tcsf__fig">
        <ol class="tcsf__zones" aria-hidden="true">
          <li data-zone="tight">Tight</li>
          <li data-zone="collarbone">Collarbone</li>
          <li data-zone="upper">Upper chest</li>
          <li data-zone="mid">Mid chest</li>
          <li data-zone="low">Low</li>
        </ol>
        <svg class="tcsf__model" viewBox="0 0 400 460" role="img" aria-label="Preview of the chain on a model" data-model>
          <defs>
            <radialGradient id="tcsf-{{ section.id }}-ice" cx="38%" cy="34%" r="70%">
              <stop offset="0" stop-color="#ffffff"/>
              <stop offset=".45" stop-color="#e3ebf6"/>
              <stop offset="1" stop-color="#8190a8"/>
            </radialGradient>
            <linearGradient id="tcsf-{{ section.id }}-metal" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" data-metal="hi"/>
              <stop offset="1" data-metal="lo"/>
            </linearGradient>
            <linearGradient id="tcsf-{{ section.id }}-skin" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" data-skin="hi"/>
              <stop offset="1" data-skin="lo"/>
            </linearGradient>
          </defs>
          <g data-body></g>
          <g data-chains></g>
        </svg>
        </div>
        <div class="tcsf__badge" data-badge><span data-out="badgeLen">20"</span><small data-out="badgeZone">Collarbone</small></div>
      </div>

      <div class="tcsf__panel">
        <!-- Quiz -->
        <form class="tcsf__quiz" novalidate>
          <div class="tcsf__progress" aria-hidden="true"><span data-progress></span></div>
          <p class="tcsf__stepcount" data-stepcount>Step 1 of 4</p>

          <section class="tcsf__q is-active" data-step="1">
            <h3>What's your neck size?</h3>
            <div class="tcsf__seg" role="radiogroup" aria-label="How to enter neck size">
              <label><input type="radio" name="neckMode" value="measure" checked><span>I measured it</span></label>
              <label><input type="radio" name="neckMode" value="collar"><span>Shirt collar size</span></label>
              <label><input type="radio" name="neckMode" value="unknown"><span>No idea</span></label>
            </div>

            <div class="tcsf__neck" data-mode="measure">
              <div class="tcsf__dial">
                <button type="button" class="tcsf__step-btn" data-nudge="-1" aria-label="Decrease">&minus;</button>
                <label class="tcsf__dial-val">
                  <input type="number" name="neck" min="10" max="26" step="0.5" value="16" inputmode="decimal" aria-label="Neck measurement">
                  <span data-out="unitLabel">in</span>
                </label>
                <button type="button" class="tcsf__step-btn" data-nudge="1" aria-label="Increase">+</button>
              </div>
              <div class="tcsf__seg tcsf__seg--center" role="radiogroup" aria-label="Unit">
                <label><input type="radio" name="unit" value="in" checked><span>inches</span></label>
                <label><input type="radio" name="unit" value="cm"><span>cm</span></label>
              </div>
              <details class="tcsf__tip">
                <summary>How do I measure?</summary>
                <p>No tape measure? Wrap a phone charger cable or a piece of string around the base of your neck where a chain would sit, mark where it meets, then lay it along a ruler. Keep it snug, not tight.</p>
              </details>
            </div>

            <div class="tcsf__neck" data-mode="collar" hidden>
              <div class="tcsf__chips" role="radiogroup" aria-label="Shirt collar size">
                <label><input type="radio" name="collar" value="14"><span>14"<small>S</small></span></label>
                <label><input type="radio" name="collar" value="14.5"><span>14½"<small>S</small></span></label>
                <label><input type="radio" name="collar" value="15"><span>15"<small>M</small></span></label>
                <label><input type="radio" name="collar" value="15.5"><span>15½"<small>M</small></span></label>
                <label><input type="radio" name="collar" value="16" checked><span>16"<small>L</small></span></label>
                <label><input type="radio" name="collar" value="16.5"><span>16½"<small>L</small></span></label>
                <label><input type="radio" name="collar" value="17"><span>17"<small>XL</small></span></label>
                <label><input type="radio" name="collar" value="17.5"><span>17½"<small>XL</small></span></label>
                <label><input type="radio" name="collar" value="18"><span>18"<small>2XL</small></span></label>
                <label><input type="radio" name="collar" value="18.5"><span>18½"<small>2XL</small></span></label>
                <label><input type="radio" name="collar" value="19"><span>19"<small>3XL</small></span></label>
                <label><input type="radio" name="collar" value="20"><span>20"<small>3XL+</small></span></label>
              </div>
              <p class="tcsf__hint">Collars are cut with a little room, so we take ½" off to get your neck size.</p>
            </div>

            <div class="tcsf__neck" data-mode="unknown" hidden>
              <div class="tcsf__seg" role="radiogroup" aria-label="Wearer">
                <label><input type="radio" name="wearer" value="men" checked><span>For him</span></label>
                <label><input type="radio" name="wearer" value="women"><span>For her</span></label>
              </div>
              <p class="tcsf__hint">We'll start from an average neck (15½" for men, 13½" for women). Buying a gift? This is a safe bet.</p>
            </div>

            <div class="tcsf__nav">
              <button type="button" class="tcsf__btn" data-go="next">Next</button>
            </div>
          </section>

          <section class="tcsf__q" data-step="2" hidden>
            <h3>Where should it hit?</h3>
            <p class="tcsf__sub">Watch the model. The chain moves as you choose.</p>
            <div class="tcsf__cards" role="radiogroup" aria-label="Fit">
              <label class="tcsf__card"><input type="radio" name="fit" value="choker"><span><i data-icon="tight"></i><strong>Tight</strong><small>Hugs the neck</small></span></label>
              <label class="tcsf__card"><input type="radio" name="fit" value="collarbone" checked><span><i data-icon="collarbone"></i><strong>Collarbone</strong><small>The classic</small></span></label>
              <label class="tcsf__card"><input type="radio" name="fit" value="upper"><span><i data-icon="upper"></i><strong>Upper chest</strong><small>Shows over a tee</small></span></label>
              <label class="tcsf__card"><input type="radio" name="fit" value="mid"><span><i data-icon="mid"></i><strong>Mid chest</strong><small>Statement drop</small></span></label>
              <label class="tcsf__card"><input type="radio" name="fit" value="low"><span><i data-icon="low"></i><strong>Low</strong><small>Made to layer</small></span></label>
            </div>
            <div class="tcsf__nav">
              <button type="button" class="tcsf__btn tcsf__btn--ghost" data-go="back">Back</button>
              <button type="button" class="tcsf__btn" data-go="next">Next</button>
            </div>
          </section>

          <section class="tcsf__q" data-step="3" hidden>
            <h3>What's your build?</h3>
            <p class="tcsf__sub">A broad chest and traps take up length, so the chain sits higher.</p>
            <div class="tcsf__cards tcsf__cards--4" role="radiogroup" aria-label="Build">
              <label class="tcsf__card"><input type="radio" name="build" value="slim"><span><i data-build="slim"></i><strong>Slim</strong></span></label>
              <label class="tcsf__card"><input type="radio" name="build" value="average" checked><span><i data-build="average"></i><strong>Average</strong></span></label>
              <label class="tcsf__card"><input type="radio" name="build" value="athletic"><span><i data-build="athletic"></i><strong>Athletic</strong></span></label>
              <label class="tcsf__card"><input type="radio" name="build" value="large"><span><i data-build="large"></i><strong>Broad / Big</strong></span></label>
            </div>
            <div class="tcsf__nav">
              <button type="button" class="tcsf__btn tcsf__btn--ghost" data-go="back">Back</button>
              <button type="button" class="tcsf__btn" data-go="next">Next</button>
            </div>
          </section>

          <section class="tcsf__q" data-step="4" hidden>
            <h3>How iced out?</h3>
            <p class="tcsf__sub">Pick a width. Wider links are stiffer, so they need a touch more length.</p>
            <div class="tcsf__widths" role="radiogroup" aria-label="Chain width">
              <label><input type="radio" name="width" value="2"><span><b style="--d:6px"></b>2mm<small>Subtle</small></span></label>
              <label><input type="radio" name="width" value="3"><span><b style="--d:9px"></b>3mm<small>Everyday</small></span></label>
              <label><input type="radio" name="width" value="4" checked><span><b style="--d:12px"></b>4mm<small>Classic</small></span></label>
              <label><input type="radio" name="width" value="5"><span><b style="--d:15px"></b>5mm<small>Bold</small></span></label>
              <label><input type="radio" name="width" value="6"><span><b style="--d:18px"></b>6mm<small>Heavy</small></span></label>
              <label><input type="radio" name="width" value="7"><span><b style="--d:21px"></b>7mm+<small>Iced out</small></span></label>
            </div>
            <div class="tcsf__nav">
              <button type="button" class="tcsf__btn tcsf__btn--ghost" data-go="back">Back</button>
              <button type="button" class="tcsf__btn tcsf__btn--glow" data-go="reveal">Reveal my size ✦</button>
            </div>
          </section>
        </form>

        <!-- Result -->
        <div class="tcsf__res" hidden aria-live="polite">
          <p class="tcsf__res-label">Your perfect length</p>
          <p class="tcsf__length"><span data-out="length">20</span><span class="tcsf__unit">"</span></p>
          <p class="tcsf__res-meta"><span data-out="cm">51</span> cm · about <span data-out="stones">120</span> diamonds</p>
          <p class="tcsf__summary" data-out="summary"></p>

          <div class="tcsf__tune">
            <div class="tcsf__tune-row">
              <div class="tcsf__tune-head"><span>Try other lengths</span><button type="button" class="tcsf__link" data-reset hidden>Back to my size</button></div>
              <input class="tcsf__range" type="range" min="16" max="30" step="2" value="20" data-length aria-label="Chain length">
              <div class="tcsf__ticks" aria-hidden="true"><span>16"</span><span>18"</span><span>20"</span><span>22"</span><span>24"</span><span>26"</span><span>28"</span><span>30"</span></div>
            </div>

            <div class="tcsf__tune-row">
              <span class="tcsf__tune-title">Width</span>
              <div class="tcsf__seg tcsf__seg--xs" role="radiogroup" aria-label="Width" data-mirror="width">
                <label><input type="radio" name="width2" value="2"><span>2</span></label>
                <label><input type="radio" name="width2" value="3"><span>3</span></label>
                <label><input type="radio" name="width2" value="4"><span>4</span></label>
                <label><input type="radio" name="width2" value="5"><span>5</span></label>
                <label><input type="radio" name="width2" value="6"><span>6</span></label>
                <label><input type="radio" name="width2" value="7"><span>7+</span></label>
              </div>
            </div>

            <div class="tcsf__tune-row tcsf__tune-row--split">
              <div>
                <span class="tcsf__tune-title">Metal</span>
                <div class="tcsf__swatches" role="radiogroup" aria-label="Metal">
                  <label title="White gold"><input type="radio" name="metal" value="white" checked><span style="--c1:#f4f6f9;--c2:#9ea5b0"></span></label>
                  <label title="Yellow gold"><input type="radio" name="metal" value="yellow"><span style="--c1:#f7dc85;--c2:#b0831f"></span></label>
                  <label title="Rose gold"><input type="radio" name="metal" value="rose"><span style="--c1:#f4c7b5;--c2:#b06a58"></span></label>
                </div>
              </div>
              <div>
                <span class="tcsf__tune-title">Model</span>
                <div class="tcsf__swatches" role="radiogroup" aria-label="Skin tone">
                  <label title="Light"><input type="radio" name="skin" value="1"><span style="--c1:#f3d3bb;--c2:#d9a887"></span></label>
                  <label title="Medium"><input type="radio" name="skin" value="2" checked><span style="--c1:#d9a178;--c2:#b0754d"></span></label>
                  <label title="Tan"><input type="radio" name="skin" value="3"><span style="--c1:#a8704a;--c2:#7c4d30"></span></label>
                  <label title="Deep"><input type="radio" name="skin" value="4"><span style="--c1:#6e4630;--c2:#43291b"></span></label>
                </div>
              </div>
            </div>

            <label class="tcsf__toggle">
              <input type="checkbox" data-layer>
              <span class="tcsf__switch" aria-hidden="true"></span>
              <span>Layer it: add chains 2" and 4" longer</span>
            </label>
          </div>

          {%- if section.settings.shop_url != blank -%}
            <a class="tcsf__btn tcsf__btn--glow tcsf__cta" href="{{ section.settings.shop_url }}" data-cta>{{ section.settings.cta_label }}</a>
          {%- endif -%}
          <div class="tcsf__res-foot">
            <button type="button" class="tcsf__link" data-go="restart">Change my answers</button>
            <button type="button" class="tcsf__link" data-copy>Copy my size</button>
          </div>
          <p class="tcsf__fine">{{ section.settings.fine_print }}</p>
        </div>
      </div>
    </div>

    <div class="tcsf__chart">
      <h3>Tennis chain length chart (men's)</h3>
      <div class="tcsf__table-wrap">
        <table>
          <thead><tr><th>Length</th><th>Where it sits on an average man (15½"–16" neck)</th></tr></thead>
          <tbody>
            <tr data-len="16"><td>16"</td><td>Tight at the base of the neck. Best for slim necks or a choker look.</td></tr>
            <tr data-len="18"><td>18"</td><td>Base of the neck to just above the collarbone.</td></tr>
            <tr data-len="20"><td>20"</td><td>On the collarbone. The classic tennis chain look.</td></tr>
            <tr data-len="22"><td>22"</td><td>Just below the collarbone. Shows over a crew neck.</td></tr>
            <tr data-len="24"><td>24"</td><td>Upper chest. A good pick for broad or athletic builds.</td></tr>
            <tr data-len="26"><td>26"</td><td>Mid chest. A classic length with a pendant.</td></tr>
            <tr data-len="28"><td>28"–30"</td><td>Low chest / sternum. Made for layering.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="tcsf__hint">Stacking chains? Space them about 2" apart (for example 20" + 22" + 24") so they don't tangle.</p>
    </div>
  </div>
</div>

<style>
  #tcsf-{{ section.id }} {
    --tcsf-bg: {{ section.settings.color_bg }};
    --tcsf-fg: {{ section.settings.color_text }};
    --tcsf-accent: {{ section.settings.color_accent }};
    --tcsf-card: rgba(127,127,127,.09);
    --tcsf-line: rgba(127,127,127,.3);
  }
  .tcsf { background: var(--tcsf-bg); color: var(--tcsf-fg); padding: 64px 16px; overflow: hidden; }
  .tcsf *, .tcsf *::before, .tcsf *::after { box-sizing: border-box; }
  .tcsf [hidden] { display: none !important; }
  .tcsf__inner { max-width: 1160px; margin: 0 auto; }

  .tcsf__header { text-align: center; max-width: 680px; margin: 0 auto 36px; }
  .tcsf__eyebrow { text-transform: uppercase; letter-spacing: .22em; font-size: 12px; color: var(--tcsf-accent); margin: 0 0 10px; }
  .tcsf__title { font-size: clamp(30px, 4.6vw, 48px); line-height: 1.1; margin: 0 0 14px; color: inherit; }
  .tcsf__intro { margin: 0; opacity: .8; line-height: 1.55; font-size: 17px; }
  .tcsf__strand { display: block; width: min(100%, 520px); height: auto; margin: 26px auto 0; }

  .tcsf__app { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: stretch; }
  .tcsf__stage { position: relative; border-radius: 20px; background: radial-gradient(120% 80% at 50% 0%, rgba(255,255,255,.07), transparent 60%), var(--tcsf-card); border: 1px solid var(--tcsf-line); min-height: 520px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .tcsf__fig { position: relative; width: 100%; max-width: 480px; }
  .tcsf__model { width: 100%; height: auto; display: block; }
  .tcsf__zones { position: absolute; left: 0; top: 0; bottom: 0; margin: 0; padding: 0; list-style: none; font-size: 11px; text-transform: uppercase; letter-spacing: .12em; pointer-events: none; z-index: 1; }
  .tcsf__zones li { position: absolute; left: 0; white-space: nowrap; opacity: .35; transform: translateY(-50%); transition: opacity .3s, color .3s; padding-left: 14px; text-shadow: 0 1px 3px rgba(0,0,0,.6); }
  .tcsf__zones li::before { content: ""; position: absolute; left: 0; top: 50%; width: 8px; height: 1px; background: currentColor; }
  .tcsf__zones li.is-on { opacity: 1; color: var(--tcsf-accent); font-weight: 700; }
  .tcsf__zones li.is-on::before { width: 10px; height: 2px; margin-top: -1px; }
  .tcsf__badge { position: absolute; right: 16px; top: 16px; background: var(--tcsf-bg); border: 1px solid var(--tcsf-line); border-radius: 14px; padding: 10px 14px; text-align: center; line-height: 1.1; z-index: 1; }
  .tcsf__badge span { display: block; font-size: 26px; font-weight: 700; color: var(--tcsf-accent); font-variant-numeric: tabular-nums; }
  .tcsf__badge small { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; opacity: .7; }
  .tcsf__badge.is-pop { animation: tcsf-pop .45s ease; }

  .tcsf__panel { border-radius: 20px; border: 1px solid var(--tcsf-line); padding: 28px; min-width: 0; display: flex; flex-direction: column; }
  .tcsf__progress { height: 4px; border-radius: 4px; background: var(--tcsf-line); overflow: hidden; }
  .tcsf__progress span { display: block; height: 100%; width: 25%; background: var(--tcsf-accent); border-radius: 4px; transition: width .4s ease; }
  .tcsf__stepcount { font-size: 12px; text-transform: uppercase; letter-spacing: .14em; opacity: .6; margin: 12px 0 0; }
  .tcsf__q { animation: tcsf-in .35s ease both; }
  .tcsf__q h3, .tcsf__res h3 { font-size: clamp(22px, 2.6vw, 28px); margin: 6px 0 6px; color: inherit; line-height: 1.2; }
  .tcsf__sub { margin: 0 0 18px; opacity: .72; font-size: 15px; line-height: 1.5; }
  .tcsf__q h3 + .tcsf__seg { margin-top: 16px; }
  .tcsf__hint { font-size: 13px; line-height: 1.5; opacity: .7; margin: 12px 0 0; }

  .tcsf input[type="radio"], .tcsf input[type="checkbox"] { position: absolute; opacity: 0; pointer-events: none; }
  .tcsf label { cursor: pointer; }
  .tcsf__seg { display: flex; flex-wrap: wrap; gap: 8px; }
  .tcsf__seg--center { justify-content: center; }
  .tcsf__seg span { display: inline-flex; align-items: center; min-height: 42px; padding: 8px 16px; border: 1px solid var(--tcsf-line); border-radius: 999px; font-size: 14px; transition: border-color .15s, background .15s, color .15s; }
  .tcsf__seg--xs span { min-height: 36px; min-width: 40px; justify-content: center; padding: 6px 10px; }
  .tcsf input:checked + span { border-color: var(--tcsf-accent); background: var(--tcsf-accent); color: var(--tcsf-bg); }
  .tcsf input:focus-visible + span, .tcsf input:focus-visible + .tcsf__switch { outline: 2px solid var(--tcsf-accent); outline-offset: 2px; }

  .tcsf__neck { margin-top: 18px; }
  .tcsf__dial { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 8px 0 14px; }
  .tcsf__step-btn { width: 52px; height: 52px; border-radius: 50%; border: 1px solid var(--tcsf-line); background: transparent; color: inherit; font-size: 24px; cursor: pointer; transition: border-color .15s, transform .1s; }
  .tcsf__step-btn:hover { border-color: var(--tcsf-accent); }
  .tcsf__step-btn:active { transform: scale(.94); }
  .tcsf__dial-val { display: flex; align-items: baseline; gap: 6px; cursor: text; }
  .tcsf__dial-val input { font: inherit; font-size: 56px; font-weight: 700; width: 3.4ch; text-align: center; background: transparent; border: 0; border-bottom: 2px solid var(--tcsf-line); color: var(--tcsf-accent); padding: 0; font-variant-numeric: tabular-nums; -moz-appearance: textfield; }
  .tcsf__dial-val input::-webkit-outer-spin-button, .tcsf__dial-val input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .tcsf__dial-val input:focus { outline: none; border-bottom-color: var(--tcsf-accent); }
  .tcsf__dial-val span { font-size: 18px; opacity: .7; }
  .tcsf__tip { margin-top: 16px; border: 1px solid var(--tcsf-line); border-radius: 12px; padding: 12px 16px; font-size: 14px; }
  .tcsf__tip summary { cursor: pointer; font-weight: 600; }
  .tcsf__tip p { margin: 10px 0 0; line-height: 1.55; opacity: .8; }

  .tcsf__chips { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .tcsf__chips span { display: flex; flex-direction: column; align-items: center; padding: 10px 4px; border: 1px solid var(--tcsf-line); border-radius: 12px; font-weight: 600; transition: border-color .15s, background .15s, color .15s; }
  .tcsf__chips small { font-weight: 400; font-size: 11px; opacity: .7; }

  .tcsf__cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 10px; }
  .tcsf__card span { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 2px; height: 100%; padding: 12px 8px 14px; border: 1px solid var(--tcsf-line); border-radius: 14px; transition: border-color .15s, background .15s, color .15s, transform .15s; }
  .tcsf__card:hover span { transform: translateY(-2px); border-color: var(--tcsf-accent); }
  .tcsf__card i { display: block; width: 64px; height: 64px; margin-bottom: 6px; }
  .tcsf__card i svg { width: 100%; height: 100%; display: block; }
  .tcsf__card strong { font-size: 14px; }
  .tcsf__card small { font-size: 12px; opacity: .75; }

  .tcsf__widths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .tcsf__widths span { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 14px 6px; border: 1px solid var(--tcsf-line); border-radius: 14px; font-weight: 700; transition: border-color .15s, background .15s, color .15s; }
  .tcsf__widths small { font-weight: 400; font-size: 12px; opacity: .75; }
