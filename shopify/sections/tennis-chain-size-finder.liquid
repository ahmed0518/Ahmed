      setColors();
      if (!opts.noAnim) animateTo(y, opts.fromTop);

      root.querySelectorAll('.tcsf__zones li').forEach(function (li) {
        li.style.top = (ZONE_Y[li.dataset.zone] / 460 * 100) + '%';
        li.classList.toggle('is-on', li.dataset.zone === zone);
      });
      var badge = root.querySelector('[data-badge]');
      var showLen = app.dataset.view === 'result' || state.step > 1;
      root.querySelector('[data-out="badgeLen"]').textContent = showLen ? len + '"' : '?';
      root.querySelector('[data-out="badgeZone"]').textContent = ZONE_LABEL[zone];
      var key = len + zone;
      if (key !== lastBadge) { badge.classList.remove('is-pop'); void badge.offsetWidth; badge.classList.add('is-pop'); lastBadge = key; }
      model.setAttribute('aria-label', 'A ' + len + ' inch chain sitting at the ' + ZONE_LABEL[zone].toLowerCase());

      // Result panel
      root.querySelector('[data-out="length"]').textContent = len;
      root.querySelector('[data-out="cm"]').textContent = Math.round(len * 2.54);
      root.querySelector('[data-out="stones"]').textContent = Math.round(len * 25.4 / ((parseFloat(w) || 4) * 1.05));
      var wl = w === '7' ? '7mm+' : w + 'mm';
      var note = '';
      if (!state.override && rec.target > 30.5) note = ' Want it even longer? Contact us and we can help.';
      if (!state.override && rec.target < 15) note = ' Want it even tighter? Contact us and we can help.';
      root.querySelector('[data-out="summary"]').textContent = state.override
        ? 'A ' + len + '" ' + wl + ' chain would sit ' + (zone === 'tight' ? 'tight on your neck' : 'at your ' + ZONE_LABEL[zone].toLowerCase()) + '. Your recommended size is ' + rec.len + '".'
        : 'With a ' + fmtNeck(neckInches()) + '" neck, a ' + len + '" ' + wl + ' tennis chain sits ' + FIT[val('fit')].sentence + '.' + note;
      root.querySelector('[data-length]').value = len;
      root.querySelector('[data-reset]').hidden = !state.override || state.override === rec.len;
      setRadio('width2', w);

      var p = root.querySelector('[data-progress]');
      p.style.width = (state.step / 4 * 100) + '%';
      root.querySelector('[data-stepcount]').textContent = 'Step ' + state.step + ' of 4';

      root.querySelectorAll('.tcsf__chart tbody tr').forEach(function (tr) {
        var n = parseInt(tr.dataset.len, 10);
        tr.classList.toggle('is-match', n === len || (len >= 28 && n === 28));
      });
    }
    function zoneFromFit(f) { return f === 'choker' ? 'tight' : f; }

    function goStep(n) {
      state.step = Math.max(1, Math.min(4, n));
      root.querySelectorAll('.tcsf__q').forEach(function (q) {
        var on = +q.dataset.step === state.step;
        q.hidden = !on;
        q.classList.toggle('is-active', on);
      });
      update();
    }

    function reveal() {
      state.override = null;
      app.dataset.view = 'result';
      form.hidden = true;
      res.hidden = false;
      update({ fromTop: true });
      if (window.innerWidth < 900) root.querySelector('.tcsf__stage').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
    }

    function restart() {
      app.dataset.view = 'quiz';
      res.hidden = true;
      form.hidden = false;
      state.override = null;
      goStep(1);
    }

    // ---- Events ------------------------------------------------------------
    var advanceTimer;
    form.addEventListener('change', function (e) {
      var n = e.target.name;
      if (n === 'unit') {
        var inp = root.querySelector('[name="neck"]'), v = parseFloat(inp.value) || 16;
        inp.value = e.target.value === 'cm' ? Math.round(v * 2.54) : Math.round(v / 2.54 * 2) / 2;
        inp.step = e.target.value === 'cm' ? 1 : 0.5;
        inp.min = e.target.value === 'cm' ? 25 : 10;
        inp.max = e.target.value === 'cm' ? 66 : 26;
      }
      update();
      // Picture cards move straight to the next question.
      if ((n === 'fit' || n === 'build') && !reduced) {
        clearTimeout(advanceTimer);
        advanceTimer = setTimeout(function () { goStep(state.step + 1); }, 650);
      }
    });
    form.addEventListener('input', function (e) { if (e.target.name === 'neck') update(); });
    form.addEventListener('submit', function (e) { e.preventDefault(); });

    root.addEventListener('click', function (e) {
      var t = e.target.closest('[data-go],[data-nudge],[data-reset],[data-copy]');
      if (!t) return;
      if (t.dataset.nudge) {
        var inp = root.querySelector('[name="neck"]');
        var step = parseFloat(inp.step) || 0.5;
        var v = (parseFloat(inp.value) || 16) + step * parseFloat(t.dataset.nudge);
        inp.value = Math.min(parseFloat(inp.max), Math.max(parseFloat(inp.min), v));
        update();
      }
      var go = t.dataset.go;
      if (go === 'next') { clearTimeout(advanceTimer); goStep(state.step + 1); }
      if (go === 'back') { clearTimeout(advanceTimer); goStep(state.step - 1); }
      if (go === 'reveal') reveal();
      if (go === 'restart') restart();
      if (t.hasAttribute('data-reset')) { state.override = null; update(); }
      if (t.hasAttribute('data-copy')) {
        var w = val('width'), text = 'My tennis chain size: ' + currentLength() + '" (' + Math.round(currentLength() * 2.54) + ' cm), ' + (w === '7' ? '7mm+' : w + 'mm') + ' wide, ' + val('metal') + ' gold';
        var done = function () { t.textContent = 'Copied ✓'; setTimeout(function () { t.textContent = 'Copy my size'; }, 1800); };
        if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function () {}); else done();
      }
    });

    res.addEventListener('input', function (e) {
      if (e.target.hasAttribute('data-length')) { state.override = parseInt(e.target.value, 10); update(); }
    });
    res.addEventListener('change', function (e) {
      var n = e.target.name;
      if (n === 'width2') { setRadio('width', e.target.value); update(); }
      if (n === 'metal' || n === 'skin') { setColors(); }
      if (e.target.hasAttribute('data-layer')) { state.layer = e.target.checked; update({ noAnim: true }); renderChains(state.drop); }
    });

    drawBody(val('build'));
    setColors();
    goStep(1);
  })();
</script>

