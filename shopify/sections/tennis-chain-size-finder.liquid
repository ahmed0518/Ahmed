    })();

    function setColors() {
      var m = METAL[val('metal')] || METAL.white, k = SKIN[val('skin')] || SKIN[2];
      model.querySelector('[data-metal="hi"]').setAttribute('stop-color', m[0]);
      model.querySelector('[data-metal="lo"]').setAttribute('stop-color', m[1]);
      model.querySelector('[data-skin="hi"]').setAttribute('stop-color', k[0]);
      model.querySelector('[data-skin="lo"]').setAttribute('stop-color', k[1]);
