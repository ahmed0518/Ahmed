        '<rect x="' + (-h + 0.6) + '" y="' + (-h + 0.6) + '" width="' + (d - 1.2) + '" height="' + (d - 1.2) + '" rx="' + (d * 0.14) + '" fill="none" stroke="#000" stroke-opacity=".25" stroke-width=".6"/>' +
        '<circle r="' + r + '" fill="url(#' + ID + '-ice)"/>' +
        '<polygon points="' + f.join(' ') + '" fill="none" stroke="#fff" stroke-opacity=".75" stroke-width=".6"/>' +
        '<path d="M' + -r + ' 0 L' + r + ' 0 M0 ' + -r + ' L0 ' + r + '" stroke="#5d6b85" stroke-opacity=".35" stroke-width=".5"/>' +
        '<circle cx="' + (-r * 0.35) + '" cy="' + (-r * 0.35) + '" r="' + (r * 0.22) + '" fill="#fff" opacity=".95"/>';
    }

    function drawChain(g, drop, widthMm, seed) {
      var d = 3.4 + widthMm * 2;
      var stones = stonesAlong(chainPoints(drop), d);
      var link = stoneSvg(d), html = '', tw = [];
      stones.forEach(function (p, i) {
