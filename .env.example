# Trax Production Status — environment
# Copy to .env.local for local development. Nothing here is committed with real values.

# --- Shopify ---------------------------------------------------------------
# The myshopify domain of the store (traxnyc.com is only the storefront).
SHOPIFY_STORE_DOMAIN=05nbj6-yr.myshopify.com

# Option A (legacy): the Admin API access token (shpat_…) of an EXISTING admin-created
# custom app. New admin-created custom apps can no longer be created. Scopes needed:
# read_orders, write_orders, read_all_orders — nothing else.
SHOPIFY_ADMIN_TOKEN=

# Option B (default): a Dev Dashboard app in the TraxNYC organization. When
# SHOPIFY_ADMIN_TOKEN is empty the app mints a 24 h token with these (client credentials).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin API version. 2026-10 is the latest stable as of Oct 2026.
SHOPIFY_API_VERSION=2026-10

# TEST ONLY: full URL to …/graphql.json of the mock Shopify server. When set it wins over
# SHOPIFY_STORE_DOMAIN + SHOPIFY_API_VERSION and SHOPIFY_ADMIN_TOKEN must start with "test_".
SHOPIFY_API_URL=

# Store handle for admin links: https://admin.shopify.com/store/<handle>/orders/<id>
SHOPIFY_ADMIN_HANDLE=05nbj6-yr

# --- App secrets -------------------------------------------------------------
# 32+ random bytes as hex (64+ hex chars): openssl rand -hex 32
SESSION_SECRET=
# Same format, MUST differ from SESSION_SECRET. Rotating it invalidates every PIN.
PIN_PEPPER=
# >= 16 characters: openssl rand -base64 24 . /admin answers 404 until this is set.
ADMIN_PASSCODE=

# --- Agent access ------------------------------------------------------------
# label:token pairs for bearer-token writes, each token >= 32 random chars:
#   openssl rand -hex 24  (run once per label)
API_TOKENS=claude:<random>,maks-ai:<random>
# Optional. When set, every /api/* read needs a bearer token (this one or any API_TOKENS
# token) and every HTML page needs a staff login. Empty = public reads (default).
READ_TOKEN=

# --- Deployment --------------------------------------------------------------
# Docker behind a reverse proxy only: 1 = trust x-forwarded-for for client IPs.
TRUST_PROXY=
# Time zone for displayed dates (storage is always UTC).
DISPLAY_TZ=America/New_York
