# Trax Production Status — environment
# Copy to .env.local for local development. Nothing here is committed with real values.

# --- Shopify ---------------------------------------------------------------
# The myshopify domain of the store (traxnyc.com is only the storefront).
SHOPIFY_STORE_DOMAIN=05nbj6-yr.myshopify.com

# Option A (recommended, default): a Dev Dashboard app created in the organization that
# OWNS the store (a merchant organization — no Shopify approval needed for read_all_orders).
# Scopes on the app version: write_orders, read_all_orders (read_orders is implied by
# write_orders; listing it too is harmless). When SHOPIFY_ADMIN_TOKEN is empty the app
# mints a 24 h token with these (client credentials).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Option B (legacy): the Admin API access token (shpat_…) of an EXISTING admin-created
# custom app with the same scopes. New admin-created custom apps can no longer be created.
# When set, the client ID/secret above are not used.
SHOPIFY_ADMIN_TOKEN=

# Admin API version. 2026-10 is the latest stable as of Oct 2026.
SHOPIFY_API_VERSION=2026-10

# TEST ONLY: full URL to …/graphql.json of the mock Shopify server. When set it wins over
# SHOPIFY_STORE_DOMAIN + SHOPIFY_API_VERSION and SHOPIFY_ADMIN_TOKEN must start with "test_".
SHOPIFY_API_URL=

# Store handle for admin links: https://admin.shopify.com/store/<handle>/orders/<id>
SHOPIFY_ADMIN_HANDLE=05nbj6-yr

# --- App secrets -------------------------------------------------------------
# 32+ random bytes as hex (64+ hex chars): openssl rand -hex 32
SESSION_SECRET=
# Same format, MUST differ from SESSION_SECRET. Rotating it invalidates every PIN.
PIN_PEPPER=
# >= 16 characters: openssl rand -base64 24 . /admin answers 404 until this is set.
# Rotating it logs every admin session out (the cookie is bound to the passcode).
ADMIN_PASSCODE=

# --- Agent access ------------------------------------------------------------
# label:token pairs for bearer-token writes, each token >= 32 random chars:
#   openssl rand -hex 24  (run once per label)
API_TOKENS=claude:<random>,maks-ai:<random>
# Optional. When set, every /api/* read needs a bearer token (this one or any API_TOKENS
# token) and every HTML page needs a staff login. Empty = public reads (default).
READ_TOKEN=

# --- Deployment --------------------------------------------------------------
# Which header may name the client IP for the per-IP rate limits (and whether
# x-forwarded-host may stand in for host):
#   vercel  = on Vercel: the platform's x-real-ip / x-vercel-forwarded-for
#   1       = Docker behind exactly ONE reverse proxy that sets x-forwarded-for
#   (empty) = trust nothing; every anonymous caller shares one 60/min bucket
TRUST_PROXY=
# Time zone for displayed dates (storage is always UTC).
DISPLAY_TZ=America/New_York
